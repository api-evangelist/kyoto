  "info": {
    "_postman_id": "671842b9-7b25-43eb-93a5-76bb96365673",
    "name": "KURENAI Repository API (DSpace 7.6 + ) OAI-PMH REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Machine-readable interfaces for the Kyoto University Research Information Repository (KURENAI), a DSpace 7.6 instance. Two confirmed-live surfaces are described: the DSpace REST API (HAL+JSON) rooted at /server/api, and the OAI-PMH 2.0 metadata harvesting endpoint at /server/oai/request. Only paths and shapes verified against the live system are included. Item-level REST endpoints require authentication; the public surfaces (root, communities, collections, OAI-PMH) are anonymous.\n\nContact Support:\n Name: KURENAI Repository Administration\n Email: repository@mail2.adm.kyoto-u.ac.jp",
      "type": "text/plain"
    }
  }
